# App Configuration
APP_NAME="Shree Mahalaxmi Hardware API"
APP_ENV=production
APP_DEBUG=false
SECRET_KEY=generate-a-strong-random-hex-key-for-jwt

# Database Configuration
# Local SQLite (Development):
# DATABASE_URL=sqlite:///./carpenter_partner.db
#
# Production Serverless PostgreSQL (Neon.tech / Vercel Postgres):
DATABASE_URL=postgresql+psycopg://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Auth & Security
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=https://shreemahalaxmihardware.com,https://your-project.vercel.app,http://localhost:5173

# Session Cookie
SESSION_COOKIE_NAME=smh_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
